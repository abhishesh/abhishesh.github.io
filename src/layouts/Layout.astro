---
import '@fontsource-variable/fustat';
import '../styles/global.css';
import Navigation from '../components/Navigation.astro';
import { socialLinks } from '../lib/content';
interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}
const {
  title,
  description = 'Chasing clicks, caffeine, colognes, crisp sound, and constant jaunts — while making data boringly reliable. The personal website of Abhishesh Sharma.',
  noindex = false,
} = Astro.props;
const canonical = new URL(noindex ? '/404.html' : Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Abhishesh Sharma" />
    <meta name="theme-color" content="#090b0c" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Abhishesh Sharma" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('theme');
          if (
            [
              'light',
              'dark',
              'solarized',
              'dracula',
              'nord',
              'monokai',
              'catppuccin',
              'retro',
            ].includes(saved)
          )
            document.documentElement.dataset.theme = saved;
        } catch {
          /* The default theme also works when storage is unavailable. */
        }
      })();
    </script>
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Person',
        name: 'Abhishesh Sharma',
        url: 'https://abhishesh.com',
        sameAs: socialLinks.map((s) => s.data.href),
      })}
    />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="site-header shell">
      <a class="wordmark" href="/">
        abhishesh<span class="accent">.</span>
      </a>
      <div class="theme-switcher">
        <label for="theme-select">Appearance</label>
        <select id="theme-select" aria-label="Choose theme">
          {[
            'dark',
            'light',
            'solarized',
            'dracula',
            'nord',
            'monokai',
            'catppuccin',
            'retro',
          ].map((theme) => (
            <option value={theme}>
              {theme[0].toUpperCase() + theme.slice(1)}
            </option>
          ))}
        </select>
      </div>
    </header>
    <main id="main" class="shell" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer shell">
      <div>
        <a class="wordmark" href="/">
          Abhishesh Sharma<span class="accent">.</span>
        </a>
        <p>In perpetual search for perfection</p>
      </div>
      <nav class="footer-socials" aria-label="Social links">
        {socialLinks.map((s) => (
          <a href={s.data.href}>
            {s.data.label} <span aria-hidden="true">↗</span>
          </a>
        ))}
      </nav>
      <p class="copyright">
        Copyright &copy; {new Date().getFullYear()} | All rights reserved.
      </p>
    </footer>
    <Navigation />
    <script>
      const select = document.querySelector<HTMLSelectElement>('#theme-select');
      if (select) {
        select.value = document.documentElement.dataset.theme || 'dark';
        select.addEventListener('change', () => {
          document.documentElement.dataset.theme = select.value;
          try {
            localStorage.setItem('theme', select.value);
          } catch {
            /* Keep the current choice for this page. */
          }
        });
      }
    </script>
  </body>
</html>
