---
import Layout from '../layouts/Layout.astro';
import SectionContent from '../components/SectionContent.astro';
import { sections } from '../lib/navigation';
import { socialOrder, socialByLabel, socialIconPaths } from '../lib/content';
---

<Layout title="Abhishesh Sharma - Data & Analytics">
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-glow" aria-hidden="true"></div>
    <p class="badge">
      <span aria-hidden="true"></span>Data &amp; Analytics · Singapore
    </p>
    <h1 id="hero-title">
      Abhishesh Sharma<span class="accent">.</span>
    </h1>
    <p class="hero-subtitle">
      In perpetual search
      <br />
      for <span>perfection</span>
    </p>
    <p class="hero-tagline">
      Chasing clicks 📷, caffeine ☕️, colognes 🧴, crisp sound 🎧, and constant
      jaunts ✈️ — while making data boringly reliable
    </p>
    <div class="hero-keys">
      {socialOrder.map((label) => (
        <a class="keycap" href={socialByLabel[label]} aria-label={label}>
          <svg
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d={socialIconPaths[label]} />
          </svg>
        </a>
      ))}
      <a class="keycap explore-key" href="#explore">
        Explore my world <span aria-hidden="true">↓</span>
      </a>
    </div>
  </section>
  <section id="explore" class="explore-section" aria-labelledby="explore-title">
    <p class="eyebrow">A little bit of everything</p>
    <h2 id="explore-title">
      Curiosity, in all its forms<span class="accent">.</span>
    </h2>
    <div class="bento-grid">
      {sections.map((section) => (
        <a
          class={`bento-card bento-${section.slug}`}
          href={`/${section.slug}/`}
        >
          <span class="card-top">
            <span class="eyebrow">{section.mark}</span>
            <span class="card-arrow" aria-hidden="true">
              ↗
            </span>
          </span>
          <h3>{section.title}</h3>
          <p>{section.description}</p>
        </a>
      ))}
    </div>
  </section>
  <div class="home-content">
    <SectionContent slug="about" />
    <section id="hobbies" aria-labelledby="hobbies-title">
      <span id="tab-hobbies" aria-hidden="true"></span>
      <p class="eyebrow">Off the clock</p>
      <h2 id="hobbies-title">Hobbies</h2>
      <p class="section-subtitle">
        In this world of hyper-stimulated junk food, hobbies are the nutritional
        meal.
      </p>
      <nav class="section-nav" aria-label="Hobbies">
        <a href="#photography">Photography</a>
        <a href="#audio">Audio</a>
        <a href="#coffee">Coffee</a>
        <a href="#perfumes">Perfumes</a>
      </nav>
      <SectionContent slug="photography" />
      <SectionContent slug="audiophile" />
      <SectionContent slug="coffee" />
      <SectionContent slug="perfumes" />
    </section>
    <SectionContent slug="desk-setup" />
    <SectionContent slug="travel" />
    <SectionContent slug="projects" />
  </div>
</Layout>
